# ---------------------------------------------------------------------------
# Video Downloader configuration.
# Copy to backend/.env for local development, or to
# /etc/video-downloader/video-downloader.env on the server.
# NEVER commit the real file. Every value below has a safe default if omitted.
# ---------------------------------------------------------------------------

# "production" on the server (disables /api/docs, enforces secure cookies)
APP_ENV=development

# --- Storage ---------------------------------------------------------------
# SQLite file now; later e.g. postgresql+psycopg://user:pass@127.0.0.1/videodl
DATABASE_URL=sqlite:///./data/app.db
# Use a database number other apps on the server don't use (0-15)
REDIS_URL=redis://127.0.0.1:6379/5
QUEUE_NAME=video-downloader
# Media, temp work files and watermarks live here
DATA_DIR=./data

# --- Access ------------------------------------------------------------------
# false = open: anyone who can reach the site can use it, no sign-in. Each browser gets
#         its own private history automatically.
# true  = only accounts created with `video-downloader-cli create-admin` can use it.
REQUIRE_LOGIN=false
# How long a visitor's browser keeps its history (open mode)
GUEST_SESSION_DAYS=30
# New browser identities allowed per IP address per hour (stops bots creating thousands)
GUEST_CREATIONS_PER_IP_PER_HOUR=20
# Queued + running jobs allowed across ALL visitors (protects your other websites)
MAX_ACTIVE_JOBS_TOTAL=20

# --- Sessions & security ----------------------------------------------------
# Must be true when served over HTTPS (always, in production)
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# The exact address you open the app at, e.g. https://videos.example.com
ALLOWED_ORIGINS=https://videos.example.com

# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=120
ANALYZE_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Media limits -----------------------------------------------------------
# Downloads and processed files are deleted this many minutes after creation
RETENTION_MINUTES=60
MAX_FILESIZE_MB=500
MAX_DURATION_SECONDS=1800
ANALYZE_TIMEOUT_SECONDS=90
DOWNLOAD_TIMEOUT_SECONDS=900
PROCESS_TIMEOUT_SECONDS=900
# Total space the app may use under DATA_DIR
MAX_STORAGE_MB=5000
# New jobs are refused when the disk has less free space than this
MIN_FREE_DISK_MB=2000
MAX_PENDING_JOBS_PER_USER=5
MAX_WATERMARK_MB=5

# --- Supported sites ----------------------------------------------------------
# Comma-separated domain allowlist (subdomains included). Default covers X/Twitter,
# Instagram, Facebook, TikTok, YouTube and Reddit.
# SUPPORTED_DOMAINS=x.com,twitter.com,t.co,instagram.com,facebook.com,fb.watch,fb.com,tiktok.com,youtube.com,youtu.be,reddit.com,redd.it
# Also allow other sites that have a dedicated yt-dlp extractor (never the generic one)
ALLOW_OTHER_YTDLP_SITES=false

# --- Tools ------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# auto = libx264 if available
FFMPEG_VIDEO_ENCODER=auto
# CPU threads per FFmpeg job (0 = all cores). 2 keeps other sites responsive.
FFMPEG_THREADS=2
# JavaScript runtimes yt-dlp may use for YouTube (deno recommended, node works)
YTDLP_JS_RUNTIMES=deno,node
# Let Nginx send files (faster). Requires the matching "internal" location in Nginx.
USE_X_ACCEL_REDIRECT=false

# --- Publishing (see docs/METRICOOL.md) --------------------------------------
PUBLISHING_PROVIDER=none
PUBLISHING_SUBMIT_ENABLED=false
# JSON list of destination accounts shown in the Publish screen
PUBLISHING_ACCOUNTS=[]
# Metricool API (Advanced/Custom plans only). Leave empty until you have access.
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
